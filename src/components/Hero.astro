---
import { ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const s = ui[Astro.props.lang];
---

<section class="hero">
  <!-- Technical-paper grid: minor lines every 24px, major every 120px. -->
  <svg class="paper" aria-hidden="true">
    <defs>
      <pattern id="paper-minor" width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M24 .5H.5V24" />
      </pattern>
      <pattern id="paper-major" width="120" height="120" patternUnits="userSpaceOnUse">
        <rect width="120" height="120" fill="url(#paper-minor)" />
        <path d="M120 .5H.5V120" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#paper-major)" />
  </svg>
  <div class="container content">
    <h1>
      {s.heroTitleA} <span class="accent">{s.heroTitleAccent}</span>{s.heroTitleSep}<br />
      {s.heroTitleB}
    </h1>
    <p class="lead">{s.heroLead}</p>
    <ul class="badges">
      {
        s.badges.map((badge) => (
          <li>
            <span class="dot" />
            {badge}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .paper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .paper path {
    fill: none;
    stroke: var(--grid);
    stroke-width: 1;
    shape-rendering: crispEdges;
  }
  .content {
    position: relative;
    padding-top: 72px;
    padding-bottom: 56px;
  }
  h1 {
    margin: 0 0 18px;
    font-size: clamp(36px, 6vw, 60px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .accent {
    color: var(--cyan);
  }
  .lead {
    max-width: 560px;
    margin: 0 0 24px;
    font-size: 17px;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .badges li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    font-size: 13px;
    font-weight: 500;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 0 3px var(--cyan-soft);
  }
</style>
