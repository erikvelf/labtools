---
import { t, ui, type Lang } from '../i18n';
import type { Tool } from '../data/tools';
import ToolIcon from './ToolIcon.astro';

interface Props {
  tool: Tool;
  lang: Lang;
}

const { tool, lang } = Astro.props;
const s = ui[lang];
const name = t(tool.name, lang);
const description = t(tool.description, lang);
const searchText = [tool.name.it, tool.name.en, tool.subtitle.it, tool.subtitle.en, tool.description[lang]]
  .join(' ')
  .toLowerCase();
---

<article class="card" data-search={searchText}>
  <a class="main" href={tool.url} aria-describedby={`tip-${tool.id}`}>
    <span class="icon"><ToolIcon name={tool.icon} /></span>
    <span class="text">
      <span class="name">{name}</span>
      <span class="subtitle">{t(tool.subtitle, lang)}</span>
    </span>
  </a>
  <a
    class="src"
    href={tool.repo}
    target="_blank"
    rel="noopener"
    title={`${s.sourceLabel} (GitHub)`}
    aria-label={`${s.sourceLabel}: ${name} (GitHub)`}
  >
    <!-- GitHub mark (Octicons mark-github, 16px grid) -->
    <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
      <path
        d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
      ></path>
    </svg>
  </a>

  <div class="tip" id={`tip-${tool.id}`} role="tooltip">
    <img src={tool.preview} alt={`${s.preview}: ${name}`} width="320" height="180" loading="lazy" />
    <p>{description}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
  }
  .main {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    /* Right padding leaves room for the GitHub link. */
    padding: 14px 52px 14px 14px;
    border: 1px solid var(--border);
    border-top: 2px solid var(--blue);
    border-radius: var(--radius);
    background: var(--surface);
    white-space: nowrap;
    transition:
      border-color 0.15s,
      transform 0.15s,
      background 0.15s;
  }
  .card:hover .main,
  .main:focus-visible {
    border-color: var(--cyan);
    background: var(--surface-2);
    transform: translateY(-2px);
  }
  .icon {
    width: 40px;
    height: 40px;
    flex: none;
    display: grid;
    place-items: center;
    border: 1px solid var(--cyan-line);
    border-radius: var(--radius-sm);
    background: var(--cyan-soft);
    color: var(--cyan);
  }
  .text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .name {
    font-size: 15px;
    font-weight: 700;
    color: var(--strong);
  }
  .subtitle {
    font-size: 12.5px;
    color: var(--muted);
  }
  .src {
    position: absolute;
    top: 8px;
    right: 8px;
    display: grid;
    place-items: center;
    /* 28px keeps a comfortable touch target around the 16px icon. */
    width: 28px;
    height: 28px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--muted);
    transition:
      color 0.15s,
      border-color 0.15s,
      background 0.15s;
  }
  .src:hover,
  .src:focus-visible {
    color: var(--blue);
    border-color: var(--blue);
    background: var(--bg);
  }

  .tip {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    z-index: 20;
    width: 320px;
    max-width: 90vw;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: var(--shadow);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -4px);
    transition:
      opacity 0.15s,
      transform 0.15s,
      visibility 0.15s;
    pointer-events: none;
  }
  .card:hover .tip,
  .card:focus-within .tip {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition-delay: 0.2s;
  }
  .tip img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .tip p {
    margin: 8px 4px 2px;
    font-size: 13px;
    line-height: 1.45;
  }

  @media (hover: none) {
    .tip {
      display: none;
    }
  }
</style>
