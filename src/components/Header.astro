---
import { ui, type Lang } from '../i18n';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = ui[lang];
const other: Lang = lang === 'it' ? 'en' : 'it';
const otherHref = other === 'it' ? '/' : '/en/';
---

<header class="header">
  <div class="container inner">
    <a class="logo" href={lang === 'it' ? '/' : '/en/'}>
      <!-- LT monogram on a scope screen: graphite in both themes, blue frame, cyan trace. -->
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <rect x=".75" y=".75" width="22.5" height="22.5" rx="3.5" fill="#141414" stroke="var(--blue)" stroke-width="1.5"></rect>
        <path d="M5 5V18.5H10M14 5.5V18.5M8.5 5.5H19.5" fill="none" stroke="#3bc9db" stroke-width="2.3" stroke-linecap="square"></path>
      </svg>
      <span>{site.name}</span>
    </a>

    <nav class="nav" aria-label="Main">
      <a href="#tools">{s.navTools}</a>
      <a href="#sites">{s.navSites}</a>
      <a href="#about">{s.navAbout}</a>
    </nav>

    <label class="search">
      <span class="visually-hidden">{s.searchLabel}</span>
      <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <input id="search" type="search" placeholder={s.searchPlaceholder} autocomplete="off" spellcheck="false" />
      <kbd aria-hidden="true">/</kbd>
    </label>

    <div class="actions">
      <a class="icon-btn lang" href={otherHref} hreflang={other} title={other === 'it' ? 'Italiano' : 'English'}>
        {other.toUpperCase()}
      </a>
      <button class="icon-btn" id="theme-toggle" type="button" title={s.themeToggle} aria-label={s.themeToggle}>
        <svg class="sun" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <svg class="moon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
        </svg>
      </button>
      <a class="icon-btn" href={site.repo} target="_blank" rel="noopener" title="GitHub" aria-label="GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--strong);
    letter-spacing: -0.01em;
  }
  .nav {
    display: flex;
    gap: 20px;
    font-size: 14px;
  }
  .nav a:hover {
    color: var(--strong);
  }
  .search {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    width: 280px;
    height: 34px;
    padding: 0 8px 0 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--muted);
    transition: border-color 0.15s;
  }
  .search:focus-within {
    border-color: var(--blue);
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--strong);
    font: inherit;
    font-size: 14px;
  }
  .search input::-webkit-search-cancel-button {
    display: none;
  }
  kbd {
    font-family: var(--mono);
    font-size: 11px;
    padding: 1px 6px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--bg);
  }
  .search:focus-within kbd {
    visibility: hidden;
  }
  .actions {
    display: flex;
    gap: 8px;
  }
  .icon-btn {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .icon-btn:hover {
    border-color: var(--blue);
    color: var(--strong);
  }
  .lang {
    font-size: 12px;
    font-weight: 600;
    font-family: var(--mono);
  }
  :global([data-theme='dark']) .sun,
  :global([data-theme='light']) .moon {
    display: none;
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }
    .search {
      width: auto;
      flex: 1;
      min-width: 0;
    }
  }
  @media (max-width: 520px) {
    .inner {
      gap: 10px;
    }
    .logo span,
    kbd {
      display: none;
    }
  }
</style>
